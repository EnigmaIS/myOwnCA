# syntax=docker/dockerfile:1
# Development source image. Signed production images use Dockerfile.release.
# check=skip=SecretsUsedInArgOrEnv
# (The *_KEY_DIR / DKEK_SHARE_DIR envs below are directory PATHS, not secret
# values — this image bakes no secrets; real secrets live in the state volume's
# secrets.env, generated by the wizard. So the secret-in-ENV heuristic is a
# false positive here.)
FROM python:3.12-slim

# Non-root runtime identity. A fresh named volume mounted at MYOWNCA_STATE_DIR
# inherits this uid/gid from the image, so no root or chown-entrypoint is needed.
ARG MYOWNCA_UID=10001
ARG MYOWNCA_GID=10001
RUN groupadd --gid ${MYOWNCA_GID} myownca \
 && useradd --uid ${MYOWNCA_UID} --gid ${MYOWNCA_GID} \
      --home-dir /home/myownca --create-home --shell /usr/sbin/nologin myownca

ENV PYTHONUNBUFFERED=1 \
    MYOWNCA_STATE_DIR=/var/lib/myownca \
    MYOWNCA_SETUP_HOST=0.0.0.0 \
    MYOWNCA_BIND_HOST=0.0.0.0 \
    # All mutable data must live on the state volume, not under the (root-owned,
    # ephemeral) WORKDIR. These otherwise default to a cwd-relative ./var, which
    # in the container is /opt/myownca/var — not writable by the runtime user and
    # not on the volume. Point them at MYOWNCA_STATE_DIR so they persist and the
    # non-root user can write them.
    MYOWNCA_DATABASE_PATH=/var/lib/myownca/myownca.sqlite3 \
    MYOWNCA_ONLINE_KEY_DIR=/var/lib/myownca/online-keys \
    MYOWNCA_SERVICE_KEY_DIR=/var/lib/myownca/service-keys \
    MYOWNCA_PKCS11_DKEK_SHARE_DIR=/var/lib/myownca/dkek-shares

# Keep the OS tooling layer independent from application source changes.
RUN apt-get update \
 && apt-get install --no-install-recommends -y git

WORKDIR /opt/myownca
# Install build and runtime dependencies in a layer keyed only by pyproject.toml.
# Source-only changes therefore do not rerun dependency resolution.
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -c "import subprocess, sys, tomllib; config = tomllib.load(open('pyproject.toml', 'rb')); requirements = config['build-system']['requires'] + config['project']['dependencies']; subprocess.check_call([sys.executable, '-m', 'pip', 'install', *requirements])"

# The editable development installation includes myownca_core. setuptools-scm reads the repository
# tag through an ephemeral BuildKit bind mount; the repository metadata itself
# is not copied into the resulting layer.
COPY docs/README.md ./docs/README.md
COPY LICENSE ./LICENSE
COPY src/ ./src/
COPY core/ ./core/
RUN --mount=type=bind,source=.git,target=/opt/myownca/.git,readonly \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-deps --no-build-isolation -e . \
 && python -c "import boto3, dns.resolver, importlib, lexicon.client, lexicon.config, pkcs11, pymysql; importlib.import_module('azure.identity'); importlib.import_module('azure.keyvault.keys'); importlib.import_module('myownca_core.keygen'); print('all myownca runtime integrations present')"

# Own the state dir as the runtime user so the fresh volume inherits 10001.
RUN mkdir -p ${MYOWNCA_STATE_DIR} \
 && chmod 0700 ${MYOWNCA_STATE_DIR} \
 && chown ${MYOWNCA_UID}:${MYOWNCA_GID} ${MYOWNCA_STATE_DIR}
VOLUME ["/var/lib/myownca"]

USER myownca

# /health is served only by the online app (not the setup server), so the
# container reads unhealthy during first-run setup and healthy after finalize.
# python (not curl — absent in slim) checks the in-container service port.
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=10 \
  CMD ["python", "-c", "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"]

# Auto mode: first start runs the wizard, then boots the service after finalize.
ENTRYPOINT ["myownca"]
