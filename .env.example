MYOWNCA_DATABASE_PATH=./var/myownca.sqlite3
MYOWNCA_ONLINE_KEY_DIR=./var/online-keys
MYOWNCA_ONLINE_KEY_PASSPHRASE=change-me-for-local-testing
MYOWNCA_ONLINE_SOURCE_IDENTITY=online-host
MYOWNCA_AUTH_ENCRYPTION_SECRET=change-me-for-local-testing
MYOWNCA_SESSION_COOKIE_SECURE=false
MYOWNCA_LAB_MODE=true
# Leave blank for the Test/Lab single-admin default. Production bootstrap
# requires an explicit single_admin or dual_control choice; dual is recommended.
MYOWNCA_GOVERNANCE_MODE=
# Comma-separated roles requiring TOTP. Empty explicitly disables TOTP for all.
# Recommended defaults preserve the historical Administrator + Certificate Operator policy.
MYOWNCA_TOTP_REQUIRED_ROLES=admin,superuser
MYOWNCA_LAB_COMMON_NAME="myOwnCA Lab Issuing CA"
# Optional OpenSC reader selector for hosts with more than one smartcard/HSM.
MYOWNCA_SC_HSM_READER=
# Development/lab-only passphrase for the file-backed offline software keystore.
MYOWNCA_OFFLINE_KEY_PASSPHRASE=change-me-for-local-testing
